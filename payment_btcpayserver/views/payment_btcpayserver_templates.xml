<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The redirect form is auto-submitted by the payment framework. It only
         carries the transaction reference; the BTCPay invoice is built
         server-side from the transaction (amount and currency cannot be
         tampered with from the browser). -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <input type="hidden" name="reference" t-att-value="reference"/>
        </form>
    </template>

</odoo>
