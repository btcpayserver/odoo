<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">BTCPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group colspan="2" col="2" class="btcpay_provider_config"
                       invisible="code != 'btcpayserver'"
                       string="BTCPay Server (Greenfield API)">
                    <field name="btcpay_location"/>
                    <field name="btcpay_show_manual" invisible="btcpay_store_id or btcpay_api_key"/>
                    <field name="btcpay_store_id"
                           invisible="not btcpay_show_manual and not btcpay_store_id"/>
                    <field name="btcpay_api_key" password="True"
                           invisible="not btcpay_show_manual and not btcpay_store_id and not btcpay_api_key"/>
                    <field name="btcpay_webhook_secret" password="True"
                           invisible="not btcpay_show_manual and not btcpay_store_id and not btcpay_webhook_secret"/>
                    <div colspan="2">
                        <button name="action_btcpay_open_authorize" type="object"
                                string="Connect BTCPay Server" icon="open_in_new"
                                class="btn-primary"
                                help="Opens BTCPay in a new tab to authorize Odoo on one of your stores. Returns automatically and completes the setup."
                                invisible="btcpay_show_manual or not btcpay_location"/>
                        <button name="action_btcpay_test_connection" type="object"
                                string="Test Connection" icon="check_circle"
                                class="btn-secondary"
                                invisible="not btcpay_store_id or not btcpay_api_key"/>
                        <button name="action_btcpay_reregister_webhook" type="object"
                                string="Re-register Webhook" icon="refresh"
                                class="btn-secondary"
                                invisible="not btcpay_store_id or not btcpay_api_key"/>
                        <button name="action_btcpay_disconnect" type="object"
                                string="Disconnect" icon="link_off"
                                class="btn-secondary o_btcpay_disconnect"
                                confirm="This deletes the webhook on the BTCPay store (if possible) and clears all stored credentials. Continue?"
                                invisible="not btcpay_store_id and not btcpay_api_key"/>
                    </div>
                    <field name="btcpay_webhook_url" readonly="1"/>
                    <field name="btcpay_store_name" readonly="1" invisible="not btcpay_store_name"/>
                    <field name="btcpay_connection_status" readonly="1" invisible="not btcpay_connection_status"/>
                    <field name="btcpay_webhook_status" readonly="1" invisible="not btcpay_webhook_status"/>
                    <field name="btcpay_authorize_url" invisible="1"/>
                </group>
            </group>
        </field>
    </record>

</odoo>
