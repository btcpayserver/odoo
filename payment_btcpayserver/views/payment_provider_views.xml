<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">BTCPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group colspan="2" invisible="code != 'btcpayserver'" string="BTCPay Server (Greenfield API)">
                    <group col="2">
                        <field name="btcpay_location"/>
                        <field name="btcpay_store_id"/>
                        <field name="btcpay_api_key" password="True"/>
                    </group>
                    <field name="btcpay_webhook_url" readonly="1" colspan="2"/>
                    <group col="4" colspan="2">
                        <field name="btcpay_store_name" readonly="1" invisible="not btcpay_store_name" colspan="2"/>
                        <field name="btcpay_connection_status" readonly="1" invisible="not btcpay_connection_status" colspan="2"/>
                        <field name="btcpay_webhook_status" readonly="1" invisible="not btcpay_webhook_status" colspan="4"/>
                    </group>
                    <div colspan="2">
                        <button name="action_btcpay_test_connection" type="object"
                                string="Test Connection" icon="fa-plug"
                                class="btn-secondary"
                                invisible="not btcpay_store_id or not btcpay_api_key"/>
                        <button name="action_btcpay_reregister_webhook" type="object"
                                string="Re-register Webhook" icon="fa-refresh"
                                class="btn-secondary"
                                invisible="not btcpay_store_id or not btcpay_api_key"/>
                        <button name="action_btcpay_disconnect" type="object"
                                string="Disconnect" icon="fa-times"
                                class="btn-danger"
                                confirm="This deletes the webhook on the BTCPay store (if possible) and clears all stored credentials. Continue?"
                                invisible="not btcpay_store_id and not btcpay_api_key"/>
                    </div>
                </group>
            </group>
        </field>
    </record>

</odoo>
